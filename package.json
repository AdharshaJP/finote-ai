{
    "name": "finote-backend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "client": "cd frontend && npm run dev",
        "server": "nodemon backend/server.js",
        "ai-service": "uvicorn ai_service.main:app --host 0.0.0.0 --port 8000 --reload",
        "start": "node backend/server.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "groq-sdk": "^1.1.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.0",
        "multer": "^2.1.1",
        "node-fetch": "^3.3.2",
        "pdf-parse": "^2.4.5",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "nodemon": "^3.0.1"
    }
}
